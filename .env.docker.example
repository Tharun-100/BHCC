# Copy this file to .env.docker before starting Docker Compose.
# Use long, random values for production.
POSTGRES_DB=bhcc
POSTGRES_USER=bhcc_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=false

# Public URLs/hosts for the server. Comma-separate multiple values.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Email. Use console only for local development; production must use resend.
EMAIL_BACKEND_MODE=console
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Bhaktivedanta Healthcare <noreply@bhaktivedantahealthcare.tech>
SUPPORT_EMAIL=support@bhaktivedantahealthcare.tech
FRONTEND_URL=http://localhost:3000
ADMIN_NOTIFICATION_EMAIL=
CLINIC_TO_EMAIL=bhaktivedantahealthcarecentre@gmail.com
CLINIC_LOCATION=Bhaktivedanta Healthcare Centre, Newtown, Kolkata

# Optional payment integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
